---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects — Patrick Kohn">
  <div class="grid gap-8">
    {projects.map((project) => (
      <div>
        <div class="flex flex-wrap items-end gap-4">
          <a href={project.data.link} target="_blank" class="min-w-0 text-xl font-serif-heading font-normal hover:underline">
            {project.data.title}
          </a>
          {project.data.tags && (
            <div class="flex flex-wrap gap-x-3 gap-y-1">
              {project.data.tags.map((tag) => (
                <span class="text-sm italic text-stone-500 dark:text-stone-400">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
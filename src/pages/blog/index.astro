---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog — Patrick Kohn">
  <h1 class="text-3xl font-extrabold tracking-tight mb-4">Blog</h1>
  <p class="text-stone-600 dark:text-stone-400 mb-8">Thoughts, tutorials, and notes.</p>

  <div class="space-y-6">
    {posts.map((post) => (
      <article class="flex flex-col gap-1 border-b border-stone-200 dark:border-stone-800 pb-6">
        <time class="text-xs text-stone-500 font-mono">
          {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </time>
        <a href={`/patrickkohn-com/blog/${post.id}`} class="text-xl font-bold hover:underline">
          {post.data.title}
        </a>
        <p class="text-stone-600 dark:text-stone-400 text-sm mt-1">{post.data.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>
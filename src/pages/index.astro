---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Patrick Kohn">
  <!-- Hero / Introduction -->
  <section class="max-w-2xl">
    <p class="font-serif text-lg leading-relaxed">
      Patrick Kohn is a comedian, performing artist, and writer based in New York City. He has been cast on the Magnet Theater improv house team Midnight Snack since 2025. He previously wrote for the PIT sketch house team Alternative Medicine and now writes indie sketch along with spec screenplays. He can also be seen in bits at theaters around New York, including UCB, BCC, and more.
    </p>
  </section>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Patrick Kohn">
  <!-- Hero / Introduction -->
  <section class="max-w-2xl">
    <h1 class="text-3xl md:text-4xl font-serif font-normal text-stone-900 dark:text-stone-100 mb-6 leading-tight">
      Hello!
    </h1>
    <p class="text-lg text-stone-700 dark:text-stone-300 leading-relaxed mb-6 font-serif">
      This is a digital press, lab, and open notebook for projects, performance notes, and written work.
    </p>
  </section>

  <!-- Image Collage Placeholder (To be replaced with your collage) -->
  <section class="my-16 border border-dashed border-stone-300 dark:border-stone-800 rounded-lg p-12 text-center text-stone-400 dark:text-stone-600 font-sans-ui text-sm">
    <p class="italic">[ Image Collage Space ]</p>
  </section>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('projects')).filter((p) => p.data.featured);
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title="Patrick Kohn — Home">
  <!-- Welcome Note -->
  <section class="mb-16">
    <h2 class="text-2xl font-serif-heading italic mb-4 text-stone-800 dark:text-stone-200">
      Welcome to the studio.
    </h2>
    <p class="text-stone-700 dark:text-stone-300 leading-relaxed">
      I build digital tools, direct independent web projects, and write about software, craft, and technology. Think of this site as an open notebook and a small neighborhood marquee—part archive, part ongoing rehearsal.
    </p>
  </section>

  <hr class="border-stone-300 dark:border-stone-800 my-12" />

  <!-- Featured Works (Theater Program style) -->
  <section class="mb-16">
    <div class="flex justify-between items-baseline mb-8">
      <h3 class="text-xl font-serif-heading font-semibold tracking-wide">Selected Works</h3>
      <a href="/patrickkohn-com/projects" class="text-xs font-sans-ui uppercase tracking-widest text-stone-500 hover:text-stone-900 dark:hover:text-stone-100">
        All Works →
      </a>
    </div>

    <div class="space-y-10">
      {featuredProjects.map((project) => (
        <article class="group">
          <div class="flex justify-between items-baseline border-b border-stone-300 dark:border-stone-800 pb-2 mb-2">
            <a href={project.data.link} target="_blank" class="text-2xl font-serif-heading font-medium hover:italic transition-all">
              {project.data.title} ↗
            </a>
            {project.data.tags && (
              <span class="text-xs font-sans-ui text-stone-500 dark:text-stone-400">
                {project.data.tags.join(' • ')}
              </span>
            )}
          </div>
          <p class="text-base text-stone-600 dark:text-stone-400 leading-normal">
            {project.data.description}
          </p>
        </article>
      ))}
    </div>
  </section>

  <hr class="border-stone-300 dark:border-stone-800 my-12" />

  <!-- Journal Table of Contents -->
  <section>
    <div class="flex justify-between items-baseline mb-8">
      <h3 class="text-xl font-serif-heading font-semibold tracking-wide">Recent Writing</h3>
      <a href="/patrickkohn-com/blog" class="text-xs font-sans-ui uppercase tracking-widest text-stone-500 hover:text-stone-900 dark:hover:text-stone-100">
        The Archive →
      </a>
    </div>

    <ul class="divide-y divide-stone-200 dark:divide-stone-800">
      {recentPosts.map((post) => (
        <li class="py-4 first:pt-0 last:pb-0">
          <a href={`/patrickkohn-com/blog/${post.id}`} class="flex justify-between items-baseline group">
            <span class="text-lg font-serif-heading font-normal group-hover:italic transition-all text-stone-800 dark:text-stone-200">
              {post.data.title}
            </span>
            <time class="text-xs font-sans-ui text-stone-500 ml-4 shrink-0">
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
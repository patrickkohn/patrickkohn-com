---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A journal of projects, writing, and notes by Patrick Kohn." } = Astro.props;
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/patrickkohn-com' || currentPath === '/patrickkohn-com/';
const isProjectsPage = currentPath.startsWith('/patrickkohn-com/projects');
const isJournalPage = currentPath.startsWith('/patrickkohn-com/blog');
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const setInitialTheme = () => {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      };
      setInitialTheme();
    </script>
  </head>
  <body class="transition-colors duration-300 antialiased min-h-screen flex flex-col max-w-2xl mx-auto px-6 py-12 text-lg leading-relaxed">
    
    <!-- Journal Masthead Header -->
    <header class="mb-16 text-center">
      <div class="flex flex-col items-start gap-1 text-left sm:flex-row sm:items-end sm:justify-between sm:gap-4">
        <h1 class="shrink-0 whitespace-nowrap text-4xl sm:text-5xl font-serif-heading font-normal tracking-tight text-stone-900 dark:text-stone-100 italic">
          Patrick Kohn
        </h1>
        <p class="shrink-0 whitespace-nowrap text-sm font-sans-ui text-stone-600 dark:text-stone-400 tracking-wide sm:text-right">
          Comedy Writing • Performance Art
        </p>
      </div>

      <!-- Navigation & Dark Mode Toggle -->
      <nav class="flex justify-center items-center gap-8 mt-8 text-sm font-sans-ui uppercase tracking-wider border-t border-b border-stone-300 dark:border-stone-800 py-3">
        <a href="/patrickkohn-com/" class:list={['transition-all', 'hover:underline', { underline: isHomePage }]} aria-current={isHomePage ? 'page' : undefined}>Home</a>
        <span class="text-stone-300 dark:text-stone-700">/</span>
        <a href="/patrickkohn-com/projects" class:list={['transition-all', 'hover:underline', { underline: isProjectsPage }]} aria-current={isProjectsPage ? 'page' : undefined}>Projects</a>
        <span class="text-stone-300 dark:text-stone-700">/</span>
        <a href="/patrickkohn-com/blog" class:list={['transition-all', 'hover:underline', { underline: isJournalPage }]} aria-current={isJournalPage ? 'page' : undefined}>Journal</a>
        <span class="text-stone-300 dark:text-stone-700">/</span>
        
        <button 
          id="theme-toggle" 
          aria-label="Toggle theme" 
          class="hover:opacity-75 cursor-pointer text-base leading-none"
          onclick="
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          "
        >
          <span class="dark:hidden">☽</span>
          <span class="hidden dark:inline">☼</span>
        </button>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

   <!-- Footer with Creative Commons License -->
    <footer class="mt-24 pt-8 border-t border-stone-300 dark:border-stone-800 text-xs font-sans-ui text-stone-500 dark:text-stone-400 text-center">
      <p>
        {new Date().getFullYear()} Patrick Kohn &bull; Licensed under{' '}
        <a 
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="underline hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
        >
          CC BY-NC-SA 4.0
        </a>
      </p>
    </footer>
  </body>
</html>
---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A journal of projects, writing, and notes by Patrick Kohn." } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === baseUrl || currentPath === baseUrl.slice(0, -1);
const isProjectsPage = currentPath.startsWith(`${baseUrl}clips`) || currentPath.startsWith(`${baseUrl}projects`);
const isBlogPage = currentPath.startsWith(`${baseUrl}writing`) || currentPath.startsWith(`${baseUrl}blog`);
const isContactPage = currentPath.startsWith(`${baseUrl}contact`);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="alternate icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const themeMode = ['light', 'dark', 'auto'].includes(storedTheme) ? storedTheme : 'auto';
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.themeMode = themeMode;
      document.documentElement.classList.toggle('dark', themeMode === 'dark' || (themeMode === 'auto' && prefersDark));
    </script>
  </head>
  <body class="transition-colors duration-300 antialiased min-h-screen flex flex-col max-w-2xl mx-auto px-6 py-12 text-lg leading-relaxed">
    
    <!-- Journal Masthead Header -->
    <header class="mb-12 text-center">
      <div class="flex flex-col items-start gap-1 text-left sm:flex-row sm:items-end sm:justify-between sm:gap-4">
        <div class="relative shrink-0">
          <h1 class="whitespace-nowrap text-4xl sm:text-5xl font-serif-heading font-normal tracking-tight italic">
            Patrick Kohn
          </h1>
          <img
            src={`${baseUrl}assets/title-underline.svg`}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute left-0 top-full -mt-1 h-auto w-full"
          />
        </div>
        <p class="shrink-0 whitespace-nowrap text-sm font-sans-ui text-stone-600 dark:text-stone-400 tracking-wide sm:text-right">
          Comedy Writing • Performing Arts
        </p>
      </div>

      <!-- Navigation -->
      <div class="nav-scroll-shell" data-nav-scroll>
        <nav aria-label="Main navigation" class="nav-scroll binder-nav flex items-end justify-start text-sm font-sans-ui tracking-wider sm:justify-center" style={`--binder-tab-mask: url('${baseUrl}assets/binder-tab.svg')`}>
          <a href={baseUrl} class="binder-tab binder-tab-about" aria-current={isHomePage ? 'page' : undefined}>
            {isHomePage && <span class="binder-tab-art" aria-hidden="true"></span>}
            <span>About</span>
          </a>
          <a href={`${baseUrl}clips`} class="binder-tab binder-tab-clips" aria-current={isProjectsPage ? 'page' : undefined}>
            {isProjectsPage && <span class="binder-tab-art" aria-hidden="true"></span>}
            <span>Clips</span>
          </a>
          <a href={`${baseUrl}writing`} class="binder-tab binder-tab-blog" aria-current={isBlogPage ? 'page' : undefined}>
            {isBlogPage && <span class="binder-tab-art" aria-hidden="true"></span>}
            <span>Writing</span>
          </a>
          <a href={`${baseUrl}contact`} class="binder-tab binder-tab-contact" aria-current={isContactPage ? 'page' : undefined}>
            {isContactPage && <span class="binder-tab-art" aria-hidden="true"></span>}
            <span>Contact</span>
          </a>
        </nav>
        <button type="button" class="nav-overflow-indicator nav-overflow-left" aria-label="Scroll navigation left">
          <span aria-hidden="true"></span>
        </button>
        <button type="button" class="nav-overflow-indicator nav-overflow-right" aria-label="Scroll navigation right">
          <span aria-hidden="true"></span>
        </button>
      </div>
      <script is:inline>
        const navScrollShell = document.querySelector('[data-nav-scroll]');
        const navScroll = navScrollShell?.querySelector('.nav-scroll');

        if (navScrollShell && navScroll) {
          const overflowThreshold = 20;
          const navScrollStorageKey = 'main-nav-scroll-left';
          const scrollAmount = () => {
            const tab = navScroll.querySelector('.binder-tab');
            const gap = Number.parseFloat(getComputedStyle(navScroll).columnGap) || 0;
            return (tab?.getBoundingClientRect().width || 96) + gap;
          };
          const updateNavOverflow = () => {
            const scrollLeft = navScroll.scrollLeft;
            navScrollShell.dataset.overflowLeft = String(navScroll.scrollLeft > overflowThreshold);
            navScrollShell.dataset.overflowRight = String(scrollLeft + navScroll.clientWidth < navScroll.scrollWidth - overflowThreshold);
          };
          const revealActiveTab = () => {
            const activeTab = navScroll.querySelector('.binder-tab[aria-current="page"]');
            if (!activeTab) return;

            const navBounds = navScroll.getBoundingClientRect();
            const tabBounds = activeTab.getBoundingClientRect();
            if (tabBounds.left < navBounds.left) {
              navScroll.scrollLeft += tabBounds.left - navBounds.left;
            } else if (tabBounds.right > navBounds.right) {
              navScroll.scrollLeft += tabBounds.right - navBounds.right;
            }
          };

          navScrollShell.querySelector('.nav-overflow-left')?.addEventListener('click', () => {
            navScroll.scrollBy({ left: -scrollAmount(), behavior: 'auto' });
            updateNavOverflow();
          });
          navScrollShell.querySelector('.nav-overflow-right')?.addEventListener('click', () => {
            navScroll.scrollBy({ left: scrollAmount(), behavior: 'auto' });
            updateNavOverflow();
          });
          navScroll.addEventListener('scroll', updateNavOverflow, { passive: true });
          window.addEventListener('resize', updateNavOverflow);
          const savedScrollLeft = sessionStorage.getItem(navScrollStorageKey);
          if (savedScrollLeft !== null) {
            navScroll.scrollLeft = Number(savedScrollLeft);
          }
          revealActiveTab();
          navScroll.addEventListener('scroll', () => {
            sessionStorage.setItem(navScrollStorageKey, String(navScroll.scrollLeft));
          }, { passive: true });
          updateNavOverflow();
        }
      </script>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

   <!-- Footer with Creative Commons License -->
    <footer class="mt-24 pt-5 border-t-2 border-stone-300 dark:border-stone-800 text-xs font-sans-ui text-stone-500 dark:text-stone-400 text-center">
      <p>
        {new Date().getFullYear()} Patrick Kohn &bull; Licensed under{' '}
        <a 
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="underline hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
        >
          CC BY-NC-SA 4.0
        </a>
      </p>
      <div class="mt-2 flex items-center justify-center gap-1.5" role="group" aria-label="Color theme">
        <span>Theme:</span>
        <button type="button" data-theme-choice="light" aria-pressed="false" class="theme-choice">Light</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-theme-choice="dark" aria-pressed="false" class="theme-choice">Dark</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-theme-choice="auto" aria-pressed="false" class="theme-choice">Auto</button>
      </div>
    </footer>
    <script is:inline>
      const themeChoices = document.querySelectorAll('[data-theme-choice]');
      const colorSchemePreference = window.matchMedia('(prefers-color-scheme: dark)');
      const setThemeMode = (mode) => {
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.classList.toggle('dark', mode === 'dark' || (mode === 'auto' && colorSchemePreference.matches));
        localStorage.setItem('theme', mode);
        themeChoices.forEach((choice) => {
          choice.setAttribute('aria-pressed', String(choice.dataset.themeChoice === mode));
        });
      };

      themeChoices.forEach((choice) => {
        choice.addEventListener('click', () => setThemeMode(choice.dataset.themeChoice));
      });
      colorSchemePreference.addEventListener('change', () => {
        if (document.documentElement.dataset.themeMode === 'auto') {
          document.documentElement.classList.toggle('dark', colorSchemePreference.matches);
        }
      });
      setThemeMode(document.documentElement.dataset.themeMode || 'auto');
    </script>
  </body>
</html>
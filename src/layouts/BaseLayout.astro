---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A journal of projects, writing, and notes by Patrick Kohn." } = Astro.props;
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/patrickkohn-com' || currentPath === '/patrickkohn-com/';
const isProjectsPage = currentPath.startsWith('/patrickkohn-com/projects');
const isContactPage = currentPath.startsWith('/patrickkohn-com/contact');
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="alternate icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const themeMode = ['light', 'dark', 'auto'].includes(storedTheme) ? storedTheme : 'auto';
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.themeMode = themeMode;
      document.documentElement.classList.toggle('dark', themeMode === 'dark' || (themeMode === 'auto' && prefersDark));
    </script>
  </head>
  <body class="transition-colors duration-300 antialiased min-h-screen flex flex-col max-w-2xl mx-auto px-6 py-12 text-lg leading-relaxed">
    
    <!-- Journal Masthead Header -->
    <header class="mb-16 text-center">
      <div class="flex flex-col items-start gap-1 text-left sm:flex-row sm:items-end sm:justify-between sm:gap-4">
        <div class="relative shrink-0">
          <h1 class="whitespace-nowrap text-4xl sm:text-5xl font-serif-heading font-normal tracking-tight italic">
            Patrick Kohn
          </h1>
          <img
            src={`${import.meta.env.BASE_URL}/assets/title-underline.svg`}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute left-0 top-full -mt-1 h-auto w-full"
          />
        </div>
        <p class="shrink-0 whitespace-nowrap text-sm font-sans-ui text-stone-600 dark:text-stone-400 tracking-wide sm:text-right">
          Comedy Writing • Performing Arts
        </p>
      </div>

      <!-- Navigation -->
      <div class="nav-scroll-shell" data-nav-scroll>
        <nav aria-label="Main navigation" class="nav-scroll binder-nav flex items-end justify-start text-sm font-sans-ui tracking-wider sm:justify-center" style={`--binder-tab-mask: url('${import.meta.env.BASE_URL}/assets/binder-tab.svg')`}>
          <a href="/patrickkohn-com/" class="binder-tab binder-tab-about" aria-current={isHomePage ? 'page' : undefined}>
            {isHomePage && <span class="binder-tab-art" aria-hidden="true"></span>}
            <span>About</span>
          </a>
          <a href="/patrickkohn-com/projects" class="binder-tab binder-tab-clips" aria-current={isProjectsPage ? 'page' : undefined}>
            {isProjectsPage && <span class="binder-tab-art" aria-hidden="true"></span>}
            <span>Clips</span>
          </a>
          <a href="/patrickkohn-com/contact" class="binder-tab binder-tab-contact" aria-current={isContactPage ? 'page' : undefined}>
            {isContactPage && <span class="binder-tab-art" aria-hidden="true"></span>}
            <span>Contact</span>
          </a>
        </nav>
        <span class="nav-overflow-indicator nav-overflow-left" aria-hidden="true">&hellip;</span>
        <span class="nav-overflow-indicator nav-overflow-right" aria-hidden="true">&hellip;</span>
      </div>
      <script is:inline>
        const navScrollShell = document.querySelector('[data-nav-scroll]');
        const navScroll = navScrollShell?.querySelector('.nav-scroll');

        if (navScrollShell && navScroll) {
          const updateNavOverflow = () => {
            navScrollShell.dataset.overflowLeft = String(navScroll.scrollLeft > 0);
            navScrollShell.dataset.overflowRight = String(navScroll.scrollLeft + navScroll.clientWidth < navScroll.scrollWidth - 1);
          };

          navScroll.addEventListener('scroll', updateNavOverflow, { passive: true });
          window.addEventListener('resize', updateNavOverflow);
          updateNavOverflow();
        }
      </script>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

   <!-- Footer with Creative Commons License -->
    <footer class="mt-24 pt-8 border-t border-stone-300 dark:border-stone-800 text-xs font-sans-ui text-stone-500 dark:text-stone-400 text-center">
      <p>
        {new Date().getFullYear()} Patrick Kohn &bull; Licensed under{' '}
        <a 
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="underline hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
        >
          CC BY-NC-SA 4.0
        </a>
      </p>
      <div class="mt-2 flex items-center justify-center gap-2" role="group" aria-label="Color theme">
        <span>Theme:</span>
        <button type="button" data-theme-choice="light" aria-pressed="false" class="theme-choice">Light</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-theme-choice="dark" aria-pressed="false" class="theme-choice">Dark</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-theme-choice="auto" aria-pressed="false" class="theme-choice">Auto</button>
      </div>
    </footer>
    <script is:inline>
      const themeChoices = document.querySelectorAll('[data-theme-choice]');
      const colorSchemePreference = window.matchMedia('(prefers-color-scheme: dark)');
      const setThemeMode = (mode) => {
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.classList.toggle('dark', mode === 'dark' || (mode === 'auto' && colorSchemePreference.matches));
        localStorage.setItem('theme', mode);
        themeChoices.forEach((choice) => {
          choice.setAttribute('aria-pressed', String(choice.dataset.themeChoice === mode));
        });
      };

      themeChoices.forEach((choice) => {
        choice.addEventListener('click', () => setThemeMode(choice.dataset.themeChoice));
      });
      colorSchemePreference.addEventListener('change', () => {
        if (document.documentElement.dataset.themeMode === 'auto') {
          document.documentElement.classList.toggle('dark', colorSchemePreference.matches);
        }
      });
      setThemeMode(document.documentElement.dataset.themeMode || 'auto');
    </script>
  </body>
</html>